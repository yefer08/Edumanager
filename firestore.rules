// Reglas básicas de Firestore para desarrollo
// Estas reglas deben configurarse en Firebase Console

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura y escritura solo a usuarios autenticados
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Permitir acceso a otros documentos para usuarios autenticados
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}